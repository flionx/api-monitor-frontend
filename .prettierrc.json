{
    "trailingComma": "none",
    "printWidth": 100,
    "tabWidth": 4,
    "plugins": ["prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2,
                "useTabs": false
            }
        }
    ]
}
